<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- EPG programme reminders - runtime-requested (Android 13+) when the user first sets one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RecordingCaptureService streams a live channel to a local file for a scheduled window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Media3's DownloadManager checks current connectivity (Requirements.NETWORK) before
         running a queued download - without this, that check throws a SecurityException and the
         download fails before a single byte transfers. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- AppUpdateInstaller hands a downloaded APK to the system package installer - this app
         isn't distributed via Play Store, so self-updating needs this explicitly. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- required=false so the same APK installs on phones (no leanback feature) and TV boxes -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Package-visibility (Android 11+): without this, Search's PackageManager.resolveActivity()
         check for a voice-search handler (Google app etc.) returns null even when one is
         installed, silently hiding the mic button on every device running API 30+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- AppUpdateInstaller's queryIntentActivities() call (to explicitly grant the package
             installer read access to the downloaded APK's content:// URI) would otherwise see an
             empty list under Android 11+ package-visibility rules, silently skipping that grant. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".StreamHubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.StreamHub"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- Registers CastOptionsProvider so CastContext.getSharedInstance() has options to
             initialize with - required by the Cast SDK, not optional wiring. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.android.streamhub.cast.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.StreamHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.android.streamhub.feature.iptv.data.scheduled.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="com.android.streamhub.feature.iptv.data.scheduled.RecordingAlarmReceiver"
            android:exported="false" />
        <service
            android:name="com.android.streamhub.feature.iptv.data.scheduled.RecordingCaptureService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Media3's DownloadManager requires this to keep offline downloads running as a
             foreground service while any are in progress. -->
        <service
            android:name="com.android.streamhub.core.player.download.StreamHubDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- AppUpdateInstaller downloads the update APK into the app's private cache dir, then
             needs a content:// URI to hand it to the system package installer - a plain file://
             URI isn't accepted for ACTION_VIEW package-archive intents on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
