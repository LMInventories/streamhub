<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- EPG programme reminders - runtime-requested (Android 13+) when the user first sets one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RecordingCaptureService streams a live channel to a local file for a scheduled window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- required=false so the same APK installs on phones (no leanback feature) and TV boxes -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Package-visibility (Android 11+): without this, Search's PackageManager.resolveActivity()
         check for a voice-search handler (Google app etc.) returns null even when one is
         installed, silently hiding the mic button on every device running API 30+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".StreamHubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.StreamHub"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- Registers CastOptionsProvider so CastContext.getSharedInstance() has options to
             initialize with - required by the Cast SDK, not optional wiring. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.android.streamhub.cast.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.StreamHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.android.streamhub.feature.iptv.data.scheduled.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="com.android.streamhub.feature.iptv.data.scheduled.RecordingAlarmReceiver"
            android:exported="false" />
        <service
            android:name="com.android.streamhub.feature.iptv.data.scheduled.RecordingCaptureService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Media3's DownloadManager requires this to keep offline downloads running as a
             foreground service while any are in progress. -->
        <service
            android:name="com.android.streamhub.core.player.download.StreamHubDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
